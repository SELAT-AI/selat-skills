{
  "schema": "selat-skill/v1",
  "name": "enrich-waterfall",
  "description": "Fixed 18-call, read-only person and company enrichment bundle across Apollo, Hunter, Clado, Company Enrich, Brave Search, Diffbot KG, and SELAT-native X/Twitter. Requires a complete, coherent target; every step runs independently. Uses MPP on Tempo and x402 through the SELAT Router.",
  "maxAmount": "0.20",
  "params": {
    "email": {
      "required": true,
      "description": "Known work email for the same person identified by firstName, lastName, linkedinUrl, company, and domain. The final verifier checks this supplied email."
    },
    "firstName": {
      "required": true,
      "description": "Target person's first name, matching email and linkedinUrl."
    },
    "lastName": {
      "required": true,
      "description": "Target person's last name, matching email and linkedinUrl."
    },
    "domain": {
      "required": true,
      "description": "Bare employer/company domain, e.g. stripe.com, matching company and email."
    },
    "company": {
      "required": true,
      "description": "Employer/company name corresponding to domain and organizationId."
    },
    "linkedinUrl": {
      "required": true,
      "description": "LinkedIn person-profile URL for the same target, used by Clado profile, scrape, and contact enrichment."
    },
    "organizationId": {
      "required": true,
      "description": "Apollo organization ID for the same company. The runner cannot derive it from an earlier step, so supply it before the run."
    },
    "xHandle": {
      "required": true,
      "description": "Target person's X/Twitter username without @, matching the same identity."
    }
  },
  "steps": [
    {
      "label": "person cross-check — Apollo people enrichment (MPP on Tempo)",
      "rail": "MPP on Tempo",
      "method": "POST",
      "url": "https://apollo.mpp.paywithlocus.com/apollo/people-enrichment",
      "body": {
        "email": "${email}",
        "first_name": "${firstName}",
        "last_name": "${lastName}",
        "organization_name": "${company}",
        "domain": "${domain}",
        "linkedin_url": "${linkedinUrl}"
      },
      "maxAmount": "0.05",
      "tier": "person"
    },
    {
      "label": "person by supplied email — Hunter email enrichment (MPP on Tempo)",
      "rail": "MPP on Tempo",
      "method": "POST",
      "url": "https://hunter.mpp.paywithlocus.com/hunter/email-enrichment",
      "body": {
        "email": "${email}"
      },
      "maxAmount": "0.02",
      "tier": "person"
    },
    {
      "label": "person by supplied LinkedIn URL — Clado LinkedIn profile (MPP on Tempo)",
      "rail": "MPP on Tempo",
      "method": "POST",
      "url": "https://clado.mpp.paywithlocus.com/clado/linkedin-profile",
      "body": {
        "linkedin_url": "${linkedinUrl}"
      },
      "maxAmount": "0.02",
      "tier": "person"
    },
    {
      "label": "person plus company by supplied email — Hunter combined enrichment (MPP on Tempo)",
      "rail": "MPP on Tempo",
      "method": "POST",
      "url": "https://hunter.mpp.paywithlocus.com/hunter/combined-enrichment",
      "body": {
        "email": "${email}"
      },
      "maxAmount": "0.03",
      "tier": "person"
    },
    {
      "label": "company search by supplied name — Apollo org search (MPP on Tempo)",
      "rail": "MPP on Tempo",
      "method": "POST",
      "url": "https://apollo.mpp.paywithlocus.com/apollo/org-search",
      "body": {
        "q_organization_name": "${company}",
        "per_page": 5,
        "page": 1
      },
      "maxAmount": "0.01",
      "tier": "company"
    },
    {
      "label": "company profile by supplied domain — Company Enrich (MPP on Tempo)",
      "rail": "MPP on Tempo",
      "method": "GET",
      "url": "https://mpp.orthogonal.com/company-enrich/companies/enrich?domain=${domain}",
      "maxAmount": "0.02",
      "tier": "company"
    },
    {
      "label": "company tech and headcount — Apollo org enrichment (MPP on Tempo)",
      "rail": "MPP on Tempo",
      "method": "POST",
      "url": "https://apollo.mpp.paywithlocus.com/apollo/org-enrichment",
      "body": {
        "domain": "${domain}"
      },
      "maxAmount": "0.05",
      "tier": "company"
    },
    {
      "label": "company cross-check — Hunter company enrichment (MPP on Tempo)",
      "rail": "MPP on Tempo",
      "method": "POST",
      "url": "https://hunter.mpp.paywithlocus.com/hunter/company-enrichment",
      "body": {
        "domain": "${domain}"
      },
      "maxAmount": "0.02",
      "tier": "company"
    },
    {
      "label": "find target work email — Hunter email finder (MPP on Tempo)",
      "rail": "MPP on Tempo",
      "method": "POST",
      "url": "https://hunter.mpp.paywithlocus.com/hunter/email-finder",
      "body": {
        "domain": "${domain}",
        "first_name": "${firstName}",
        "last_name": "${lastName}"
      },
      "maxAmount": "0.02",
      "tier": "person"
    },
    {
      "label": "X/Twitter profile by supplied handle — SELAT user info (x402 through Router)",
      "rail": "x402 via Circle Gateway",
      "method": "GET",
      "url": "https://catalog.selat.ai/twitter/user/info?userName=${xHandle}",
      "maxAmount": "0.002",
      "tier": "social"
    },
    {
      "label": "LinkedIn profile detail — Clado scrape (MPP on Tempo)",
      "rail": "MPP on Tempo",
      "method": "POST",
      "url": "https://clado.mpp.paywithlocus.com/clado/scrape",
      "body": {
        "linkedin_url": "${linkedinUrl}"
      },
      "maxAmount": "0.03",
      "tier": "social"
    },
    {
      "label": "job openings by supplied Apollo organization ID (MPP on Tempo)",
      "rail": "MPP on Tempo",
      "method": "POST",
      "url": "https://apollo.mpp.paywithlocus.com/apollo/job-postings",
      "body": {
        "organization_id": "${organizationId}"
      },
      "maxAmount": "0.01",
      "tier": "signals"
    },
    {
      "label": "recent company news — Brave news search (MPP on Tempo)",
      "rail": "MPP on Tempo",
      "method": "POST",
      "url": "https://brave.mpp.paywithlocus.com/brave/news-search",
      "body": {
        "q": "${company} news",
        "count": 10,
        "freshness": "pm"
      },
      "maxAmount": "0.05",
      "tier": "signals"
    },
    {
      "label": "recent funding news — Brave news search (MPP on Tempo)",
      "rail": "MPP on Tempo",
      "method": "POST",
      "url": "https://brave.mpp.paywithlocus.com/brave/news-search",
      "body": {
        "q": "${company} funding round",
        "count": 10,
        "freshness": "py"
      },
      "maxAmount": "0.05",
      "tier": "signals"
    },
    {
      "label": "organization knowledge graph — Diffbot KG enhance (MPP on Tempo)",
      "rail": "MPP on Tempo",
      "method": "POST",
      "url": "https://diffbot-kg.mpp.paywithlocus.com/diffbot-kg/enhance",
      "body": {
        "type": "Organization",
        "name": [
          "${company}"
        ],
        "url": [
          "https://${domain}"
        ],
        "refresh": false,
        "size": 1
      },
      "maxAmount": "0.05",
      "tier": "signals"
    },
    {
      "label": "contact email and phone reveal — Clado contacts (MPP on Tempo)",
      "rail": "MPP on Tempo",
      "method": "POST",
      "url": "https://clado.mpp.paywithlocus.com/clado/contacts",
      "body": {
        "linkedin_url": "${linkedinUrl}",
        "email_enrichment": true,
        "phone_enrichment": true
      },
      "maxAmount": "0.20",
      "tier": "contact"
    },
    {
      "label": "five-result person identity search — Clado search (MPP on Tempo)",
      "rail": "MPP on Tempo",
      "method": "POST",
      "url": "https://clado.mpp.paywithlocus.com/clado/search",
      "body": {
        "query": "${firstName} ${lastName} ${company}",
        "companies": [
          "${company}"
        ],
        "limit": 5,
        "offset": 0
      },
      "maxAmount": "0.06",
      "tier": "person"
    },
    {
      "label": "verify supplied work email — Hunter email verifier (MPP on Tempo)",
      "rail": "MPP on Tempo",
      "method": "POST",
      "url": "https://hunter.mpp.paywithlocus.com/hunter/email-verifier",
      "body": {
        "email": "${email}"
      },
      "maxAmount": "0.015",
      "tier": "verify"
    }
  ]
}
