{
  "schema": "selat-skill/v1",
  "name": "scrapecreators",
  "description": "Multi-merchant social media scraping across SELAT-native (X/Twitter — catalog.selat.ai, x402 via Circle Gateway), StableSocial (Instagram + TikTok — MPP, via the SELAT Router), and Clado (LinkedIn — MPP on Tempo): profiles, tweets, posts, company pages, and hashtag/keyword searches. Mixed rail; each capability is compiled into a selat-pay call by the selat CLI.",
  "maxAmount": "0.75",
  "params": {
    "handle": {
      "required": false,
      "default": "openai",
      "description": "Social handle without @ (used by the X/Twitter, Instagram, and TikTok profile/posts lookups)."
    },
    "tweetId": {
      "required": false,
      "default": "1234567890123456789",
      "description": "Numeric tweet ID for the X/Twitter tweet-details lookup (catalog.selat.ai takes tweet IDs, not tweet URLs)."
    },
    "linkedinUrl": {
      "required": false,
      "default": "https://linkedin.com/in/satyanadella",
      "description": "LinkedIn profile URL."
    },
    "linkedinPostUrl": {
      "required": false,
      "default": "https://linkedin.com/posts/somepost",
      "description": "LinkedIn post URL."
    },
    "linkedinCompanyUrl": {
      "required": false,
      "default": "https://linkedin.com/company/anthropic",
      "description": "LinkedIn company page URL."
    },
    "instagramHandle": {
      "required": false,
      "default": "openai",
      "description": "Instagram handle for the secondary profile lookup (StableSocial resolves profiles by handle; replaces the old numeric userId lookup)."
    },
    "hashtag": {
      "required": false,
      "default": "tech",
      "description": "TikTok hashtag to search for, without #."
    }
  },
  "steps": [
    {
      "label": "X/Twitter profile — SELAT Twitter API (x402 via Circle Gateway)",
      "rail": "x402 via Circle Gateway",
      "method": "GET",
      "url": "https://catalog.selat.ai/twitter/user/info?userName=${handle}",
      "maxAmount": "0.10"
    },
    {
      "label": "X/Twitter user tweets — SELAT Twitter API (x402 via Circle Gateway)",
      "rail": "x402 via Circle Gateway",
      "method": "GET",
      "url": "https://catalog.selat.ai/twitter/user/last_tweets?userName=${handle}",
      "maxAmount": "0.10"
    },
    {
      "label": "X/Twitter tweet details — SELAT Twitter API (x402 via Circle Gateway)",
      "rail": "x402 via Circle Gateway",
      "method": "GET",
      "url": "https://catalog.selat.ai/twitter/tweets?tweet_ids=${tweetId}",
      "maxAmount": "0.10"
    },
    {
      "label": "LinkedIn profile — Clado (MPP on Tempo)",
      "rail": "MPP on Tempo",
      "method": "POST",
      "url": "https://clado.mpp.paywithlocus.com/clado/linkedin-profile",
      "body": {
        "linkedin_url": "${linkedinUrl}"
      },
      "maxAmount": "0.15"
    },
    {
      "label": "LinkedIn post — Clado scrape (MPP on Tempo)",
      "rail": "MPP on Tempo",
      "method": "POST",
      "url": "https://clado.mpp.paywithlocus.com/clado/scrape",
      "body": {
        "linkedin_url": "${linkedinPostUrl}"
      },
      "maxAmount": "0.25"
    },
    {
      "label": "LinkedIn company page — Clado scrape (MPP on Tempo)",
      "rail": "MPP on Tempo",
      "method": "POST",
      "url": "https://clado.mpp.paywithlocus.com/clado/scrape",
      "body": {
        "linkedin_url": "${linkedinCompanyUrl}"
      },
      "maxAmount": "0.25"
    },
    {
      "label": "Instagram profile — StableSocial (MPP on Tempo)",
      "rail": "MPP on Tempo",
      "method": "POST",
      "url": "https://stablesocial.dev/api/instagram/profile",
      "body": {
        "handle": "${handle}"
      },
      "maxAmount": "0.75"
    },
    {
      "label": "Instagram profile by handle — StableSocial (MPP on Tempo)",
      "rail": "MPP on Tempo",
      "method": "POST",
      "url": "https://stablesocial.dev/api/instagram/profile",
      "body": {
        "handle": "${instagramHandle}"
      },
      "maxAmount": "0.75"
    },
    {
      "label": "Instagram recent posts — StableSocial (MPP on Tempo)",
      "rail": "MPP on Tempo",
      "method": "POST",
      "url": "https://stablesocial.dev/api/instagram/posts",
      "body": {
        "handle": "${handle}"
      },
      "maxAmount": "0.75"
    },
    {
      "label": "TikTok profile — StableSocial (MPP on Tempo)",
      "rail": "MPP on Tempo",
      "method": "POST",
      "url": "https://stablesocial.dev/api/tiktok/profile",
      "body": {
        "handle": "${handle}"
      },
      "maxAmount": "0.75"
    },
    {
      "label": "TikTok hashtag search — StableSocial (MPP on Tempo)",
      "rail": "MPP on Tempo",
      "method": "POST",
      "url": "https://stablesocial.dev/api/tiktok/search-hashtag",
      "body": {
        "hashtag": "${hashtag}"
      },
      "maxAmount": "0.75"
    },
    {
      "label": "TikTok trending via keyword search — StableSocial (MPP on Tempo)",
      "rail": "MPP on Tempo",
      "method": "POST",
      "url": "https://stablesocial.dev/api/tiktok/search",
      "body": {
        "query": "trending"
      },
      "maxAmount": "0.75"
    }
  ]
}
