{
  "schema": "selat-skill/v1",
  "name": "comprehensive-enrichment",
  "description": "Fixed 13-call, read-only person + company enrichment bundle across Clado, Apollo, Hunter, Company Enrich, Diffbot KG, Exa, and Firecrawl. Requires a complete, internally consistent set of person and company identifiers; every step runs independently through the SELAT Router over MPP on Tempo.",
  "maxAmount": "0.40",
  "params": {
    "email": {
      "required": true,
      "description": "Known person work email belonging to the same person named by firstName/lastName and linkedinUrl. Drives email enrichment and verification."
    },
    "firstName": {
      "required": true,
      "description": "Person first name, matching email and linkedinUrl."
    },
    "lastName": {
      "required": true,
      "description": "Person last name, matching email and linkedinUrl."
    },
    "company": {
      "required": true,
      "description": "Employer/company name corresponding to domain and pricingUrl."
    },
    "domain": {
      "required": true,
      "description": "Bare company domain, e.g. stripe.com, matching company and pricingUrl."
    },
    "linkedinUrl": {
      "required": true,
      "description": "LinkedIn person profile URL for the same person; required by Apollo and the Clado phone lookup."
    },
    "pricingUrl": {
      "required": true,
      "description": "Public HTTPS company page to scrape for products/pricing, on the same company domain when possible."
    }
  },
  "steps": [
    {
      "label": "person deep search — Clado search (MPP on Tempo)",
      "rail": "MPP on Tempo",
      "method": "POST",
      "url": "https://clado.mpp.paywithlocus.com/clado/search",
      "body": {
        "query": "${firstName} ${lastName} ${company}"
      },
      "maxAmount": "0.40"
    },
    {
      "label": "person enrichment — Apollo people-enrichment (MPP on Tempo)",
      "rail": "MPP on Tempo",
      "method": "POST",
      "url": "https://apollo.mpp.paywithlocus.com/apollo/people-enrichment",
      "body": {
        "first_name": "${firstName}",
        "last_name": "${lastName}",
        "organization_name": "${company}",
        "linkedin_url": "${linkedinUrl}"
      },
      "maxAmount": "0.05"
    },
    {
      "label": "email enrich — Hunter email-enrichment (MPP on Tempo)",
      "rail": "MPP on Tempo",
      "method": "POST",
      "url": "https://hunter.mpp.paywithlocus.com/hunter/email-enrichment",
      "body": {
        "email": "${email}"
      },
      "maxAmount": "0.02"
    },
    {
      "label": "find work email — Hunter email-finder",
      "rail": "MPP on Tempo",
      "method": "POST",
      "url": "https://hunter.mpp.paywithlocus.com/hunter/email-finder",
      "body": {
        "domain": "${domain}",
        "first_name": "${firstName}",
        "last_name": "${lastName}"
      },
      "maxAmount": "0.02"
    },
    {
      "label": "verify email — Hunter email-verifier",
      "rail": "MPP on Tempo",
      "method": "POST",
      "url": "https://hunter.mpp.paywithlocus.com/hunter/email-verifier",
      "body": {
        "email": "${email}"
      },
      "maxAmount": "0.015"
    },
    {
      "label": "phone — Clado contacts (MPP on Tempo)",
      "rail": "MPP on Tempo",
      "method": "POST",
      "url": "https://clado.mpp.paywithlocus.com/clado/contacts",
      "body": {
        "linkedin_url": "${linkedinUrl}"
      },
      "maxAmount": "0.06"
    },
    {
      "label": "person research — Exa search (MPP on Tempo)",
      "rail": "MPP on Tempo",
      "method": "POST",
      "url": "https://exa.mpp.tempo.xyz/search",
      "body": {
        "query": "${firstName} ${lastName} ${company} recent news interviews talks"
      },
      "maxAmount": "0.01"
    },
    {
      "label": "company overview — Company Enrich lookup by domain (MPP on Tempo)",
      "rail": "MPP on Tempo",
      "method": "GET",
      "url": "https://mpp.orthogonal.com/company-enrich/companies/enrich?domain=${domain}",
      "maxAmount": "0.02"
    },
    {
      "label": "company emails — Hunter domain-search",
      "rail": "MPP on Tempo",
      "method": "POST",
      "url": "https://hunter.mpp.paywithlocus.com/hunter/domain-search",
      "body": {
        "domain": "${domain}"
      },
      "maxAmount": "0.15"
    },
    {
      "label": "funding + investors — Diffbot KG enhance (MPP on Tempo)",
      "rail": "MPP on Tempo",
      "method": "POST",
      "url": "https://diffbot-kg.mpp.paywithlocus.com/diffbot-kg/enhance",
      "body": {
        "type": "Organization",
        "name": "${company}"
      },
      "maxAmount": "0.05"
    },
    {
      "label": "pricing/features — Firecrawl extract (MPP on Tempo)",
      "rail": "MPP on Tempo",
      "method": "POST",
      "url": "https://firecrawl.mpp.tempo.xyz/v1/extract",
      "body": {
        "urls": [
          "${pricingUrl}"
        ],
        "prompt": "Extract all products, pricing tiers, and features"
      },
      "maxAmount": "0.01"
    },
    {
      "label": "competitors — Exa findSimilar",
      "rail": "MPP on Tempo",
      "method": "POST",
      "url": "https://exa.mpp.tempo.xyz/findSimilar",
      "body": {
        "url": "https://${domain}",
        "numResults": 10,
        "contents": {
          "text": true
        }
      },
      "maxAmount": "0.01"
    },
    {
      "label": "company research — Exa search (MPP on Tempo)",
      "rail": "MPP on Tempo",
      "method": "POST",
      "url": "https://exa.mpp.tempo.xyz/search",
      "body": {
        "query": "${company} recent news funding announcements partnerships press releases"
      },
      "maxAmount": "0.01"
    }
  ]
}
